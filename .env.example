# Multi-Document Research Assistant Configuration

# Server & Networking
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
# Local: mongodb://127.0.0.1:27017/multi_doc_research
# Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/multi_doc_research?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/multi_doc_research

# Upload Settings & Constraints
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Vector Search Strategy
# 'local' uses in-database storage with fast in-memory cosine similarity retrieval (default, works on any MongoDB)
# 'atlas' uses MongoDB Atlas $vectorSearch aggregation pipeline
VECTOR_SEARCH_PROVIDER=local
VECTOR_INDEX_NAME=default

# Embedding Provider
# 'local' uses @xenova/transformers all-MiniLM-L6-v2 (Zero API key required, runs locally in Node.js)
# 'gemini' uses Google GenAI gemini-embedding-001 (via @google/genai)
# 'openai' uses OpenAI text-embedding-3-small
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_API_KEY=your_key_here

# Chunking Configuration
CHUNK_TARGET_TOKENS=380
CHUNK_OVERLAP_TOKENS=60

# LLM Provider for RAG & Comparison
# 'gemini' uses Google Gemini via @google/genai (e.g. gemini-3.5-flash-lite)
# 'openai' uses OpenAI (e.g. gpt-4o-mini or gpt-4o)
# 'ollama' uses local Ollama endpoint (http://localhost:11434)
# 'mock' uses deterministic mock provider for testing
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Multi-Document Comparison Timeout
COMPARE_TIMEOUT_MS=30000

# Pre-LLM Refusal Gate: minimum raw cosine similarity on the best chunk to invoke LLM
PRE_LLM_COSINE_THRESHOLD=0.28

# Reranker Settings
# 'off' uses RRF fusion directly; 'on' loads Xenova/ms-marco-MiniLM-L-6-v2 cross-encoder
RERANKER=off

# Ollama Endpoint (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

{
  "name": "multi-doc-research-assistant-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Multi-Document Research Assistant",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "reingest": "tsx scripts/reingest.ts",
    "sync:corpus": "tsx scripts/sync_real_corpus.ts",
    "eval": "tsx eval/run_all_evals.ts",
    "eval:retrieval": "tsx eval/evaluate.ts",
    "eval:citations": "tsx eval/eval_citation_verifier.ts",
    "eval:pipeline": "tsx eval/eval_full_pipeline.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.82.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}

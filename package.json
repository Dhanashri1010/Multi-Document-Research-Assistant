{
  "name": "multi-document-research-assistant",
  "version": "1.0.0",
  "description": "Full-stack NLP Web Application: Semantic Vector Search, RAG, Multi-Document Synthesis and Cross-Analysis",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm test --prefix backend",
    "test": "npm run test:backend",
    "reingest": "npm run reingest --prefix backend",
    "eval": "npm run eval --prefix backend",
    "generate:samples": "node backend/scripts/generate_sample_papers.js"
  },
  "keywords": [
    "nlp",
    "rag",
    "vector-search",
    "embeddings",
    "research-assistant",
    "academic-papers",
    "react",
    "express",
    "mongodb"
  ],
